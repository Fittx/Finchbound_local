{
  "name": "finchbound",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server"
  ],
  "type": "module",
  "scripts": {
    "local": "node scripts/local.mjs",
    "dev": "vite",
    "build": "vite build && node scripts/check-build.mjs",
    "deploy:build": "npm run typecheck && npm run server:typecheck && npm run build && npm run server:build",
    "start": "npm --prefix server start",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "server:typecheck": "npm --prefix server run typecheck",
    "server:test": "npm --prefix server test",
    "server:test:all": "npm --prefix server run test:all",
    "setup:env": "npm --prefix server run setup:env",
    "check:env": "npm --prefix server run check:env",
    "check:toolchain": "node --test scripts/check-vite-version.test.mjs scripts/check-build.test.mjs",
    "check:frontend": "node scripts/check-scale.mjs",
    "server:db:check": "npm --prefix server run check:db"
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.76.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.7"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.34.3",
  "pnpm": {
    "overrides": {
      "vite": "^8.3.7",
      "rolldown": "~1.2.18"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "bcrypt",
      "sharp"
    ]
  }
}
