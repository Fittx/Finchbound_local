# Safe template only. Keep actual credentials in server/.env or the host's secret store.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
SERVE_CLIENT=false
CLIENT_URL=http://127.0.0.1:5173
# Development only: more addresses to trust, comma-separated (for phones on Wi-Fi, set CLIENT_URL
# to http://<this PC's Wi-Fi IP>:5173 and list http://127.0.0.1:5173 here). Refused in production.
EXTRA_CLIENT_ORIGINS=
MONGODB_URI=mongodb://localhost:27018/?replicaSet=rs0
MONGODB_DB_NAME=finchbound
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=10
# Generate a secret locally; this placeholder is intentionally rejected at startup.
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-generated-secret-before-starting
JWT_ISSUER=finchbound
JWT_AUDIENCE=finchbound-client
JWT_SESSION_MINUTES=30
JWT_REMEMBER_DAYS=30
JWT_COOKIE_NAME=fb-session
BCRYPT_ROUNDS=12
OTP_MAX_ATTEMPTS=5
OTP_TTL_MINUTES=10
PASSWORD_RESET_TTL_MINUTES=60
AUTH_RATE_LIMIT_MAX_REQUESTS=30
# Use 1 only behind the single trusted ingress in docs/deployment.md.
TRUST_PROXY=false
REQUEST_BODY_LIMIT_BYTES=32768
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
LOG_LEVEL=info
# local stores photos in server/.local/uploads for development (refused in production).
# Use r2 with the four STORAGE_* values below to test against Cloudflare R2.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.local/uploads
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_QUARANTINE_PREFIX=quarantine/
UPLOAD_TOKEN_TTL_SECONDS=600
UPLOAD_MAX_PIXELS=40000000
UPLOAD_MAX_PER_DRAFT=6
UPLOAD_CONCURRENCY=2
UPLOAD_PROCESS_TIMEOUT_SECONDS=15
# Local SMTP is the default. Render Free uses EMAIL_PROVIDER=brevo over HTTPS.
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
EMAIL_FROM=
# All four SMTP text fields are needed when EMAIL_PROVIDER=smtp.
# 587 uses STARTTLS; 465 requires SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TURNSTILE_ACTION=guest-upload
# Leave empty for local development (guests get a dev-only skip button). Required in production.
TURNSTILE_SECRET=
# Comma-separated emails that get the admin role (platform report queue at /admin).
# This is the only way to grant admin. Leave empty for no admins.
ADMIN_EMAILS=
MAINTENANCE_INTERVAL_MS=60000
