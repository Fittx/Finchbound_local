{
  "name": "@finchbound/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "node scripts/test-all.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "check:env": "tsx scripts/check-env.ts",
    "check:db": "tsx scripts/check-db.ts --probe"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.1.0",
    "file-type": "^22.3.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.12.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.4.1",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.17",
    "@types/nodemailer": "^7.0.11",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
